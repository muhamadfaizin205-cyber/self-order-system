# Database PostgreSQL
DATABASE_URL="postgresql://postgres:password@localhost:5432/gacoan?schema=public"

# Secret untuk menandatangani token meja (JWT). Ganti dengan string acak panjang.
JWT_SECRET="ganti-dengan-secret-acak-yang-panjang"

# Server
PORT=4000

# Midtrans (KOSONGKAN untuk mode mock/development).
# Isi server key untuk mengaktifkan QRIS asli.
MIDTRANS_SERVER_KEY=""
MIDTRANS_PRODUCTION="false"
